{
  "name": "Debt",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the debt (e.g., Credit Card, Student Loan)"
    },
    "debt_type": {
      "type": "string",
      "enum": [
        "credit_card",
        "vehicle_loan",
        "home_loan",
        "pawn_loan",
        "other"
      ],
      "default": "other",
      "description": "Category of the debt"
    },
    "total_amount": {
      "type": "number",
      "description": "Total debt amount"
    },
    "current_balance": {
      "type": "number",
      "description": "Current remaining balance"
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate as percentage"
    },
    "minimum_payment": {
      "type": "number",
      "description": "Minimum monthly payment amount"
    },
    "due_date": {
      "type": "number",
      "description": "Day of month payment is due (1-31)",
      "minimum": 1,
      "maximum": 31
    },
    "credit_limit": {
      "type": "number",
      "description": "Total credit line limit (for credit cards)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paid_off"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "total_amount",
    "current_balance",
    "interest_rate"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}